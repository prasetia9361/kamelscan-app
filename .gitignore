# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/*
# Konfigurasi Run Android Studio sengaja DIIKUTKAN. Tanpa ini, tombol Run di
# editor menjalankan aplikasi tanpa --dart-define-from-file dan aplikasi
# berhenti di layar "Konfigurasi belum lengkap".
!.idea/runConfigurations/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Berkas hasil code generation. Jalankan `dart run build_runner build` setelah
# clone; CI juga wajib menjalankannya sebelum `flutter analyze`.
*.freezed.dart
*.g.dart
lib/l10n/generated/

# Data sensitif — JANGAN pernah di-commit
dataapp.md
panduan_dokumentasi.md

# Variabel lingkungan (Bab 4.4). Hanya env.example.json yang boleh masuk repo.
env.dev.json
env.staging.json
env.prod.json
*.env

# Keluaran build. `/build/` saja tidak cukup: Gradle juga menulis
# android/build/ (mis. laporan `problems-report.html`) yang sempat ikut
# ter-commit karena hanya folder build di akar yang diabaikan.
**/build/
.gradle/
/android/.gradle/
/android/local.properties

# Kunci penandatanganan Android
/android/key.properties
**/*.keystore
**/*.jks

# Berkas konfigurasi layanan pihak ketiga
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Dependensi alat bantu (punya pubspec sendiri)
tool/**/.dart_tool/

# Berkas sementara Supabase CLI
supabase/.temp/

# Cache Wrangler (Cloudflare Pages). Dibuat ulang otomatis tiap deploy.
.wrangler/

# Berkas kerja Claude Code — SELURUHNYA, tanpa kecuali.
#
# 🔴 `.claude/worktrees/` berisi SALINAN UTUH repositori ini — beberapa buah,
# masing-masing lengkap dengan `env.dev.json` dan `dataapp.md` yang justru
# sengaja dijaga agar tidak pernah masuk git. Satu kali `git add -A` di
# checkout utama akan mencoba memasukkan ribuan berkas, termasuk kredensial.
#
# `settings.json` sempat dikecualikan agar setelan proyek ikut dibagi, lalu
# ikut diabaikan atas keputusan Product Owner 29 Agustus 2026: repositori ini
# tidak menyimpan jejak perkakas apa pun. Setelannya pindah ke tingkat mesin
# (`~/.claude/settings.json`), yang justru berlaku untuk SETIAP worktree dan
# setiap proyek — tempat yang lebih tepat, dan tidak mungkin terlupa saat
# worktree baru dibuat.
.claude/
