<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- 🔴 Diubah dari ?android:colorBackground menjadi warna tetap.
         Bawaan Flutter memakai warna latar tema sistem, dan itulah yang
         menghasilkan kilatan putih di celah antara layar peluncur hilang dan
         bingkai pertama Flutter tergambar. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
