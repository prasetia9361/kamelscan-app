<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar peluncur KamelScan — MODE TERANG.

  Latar #F2F5F9 dipilih SENGAJA, bukan putih. Lambang KamelScan duduk di dalam
  kotak putih; kalau latarnya juga putih, kotak itu lenyap dan yang tampak
  hanya lambang melayang. #F2F5F9 adalah warna latar halaman di aplikasi, jadi
  peralihan dari layar peluncur ke aplikasi tidak terasa berkedip.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
